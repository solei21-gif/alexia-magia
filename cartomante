:root{
  --bg:#07030b; --bg2:#12081c; --wine:#3b1466; --rose:#8a3fe0; --gold:#cdaeff; --gold2:#8a5bd6; --text:#efe6f7; --muted:#a99bbb;
  --serif:'Cormorant Garamond',Georgia,'Times New Roman',serif;
  --display:'Cinzel Decorative',Georgia,serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--serif);font-size:1.2rem;line-height:1.65}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1100px,100% - 2.5rem);margin-inline:auto}
section{padding:4.5rem 0}
h1,h2,h3{font-family:var(--display);font-weight:700;color:var(--gold);line-height:1.2;margin:0 0 1rem}
h2{font-size:clamp(1.6rem,4.5vw,2.4rem);text-align:center}
h3{font-size:1.15rem}
p{margin:0 0 1rem}
.lead{text-align:center;color:var(--muted);max-width:42rem;margin:0 auto 2.5rem}
.btn{display:inline-flex;align-items:center;gap:.6rem;background:linear-gradient(135deg,var(--rose),var(--wine));color:#fff;text-decoration:none;font-weight:600;font-size:1.15rem;padding:.9rem 1.8rem;border-radius:999px;border:1px solid var(--gold2);box-shadow:0 0 28px rgba(138,63,224,.45);transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 0 40px rgba(138,63,224,.7)}
.btn:focus-visible,a:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.btn.ghost{background:transparent;box-shadow:none;color:var(--gold)}

/* hero */
.hero{padding:3rem 0 4rem;background:radial-gradient(ellipse at 75% 30%,rgba(138,63,224,.28),transparent 60%),var(--bg)}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:3rem;align-items:center}
.hero h1{font-size:clamp(2.4rem,7vw,4.4rem);text-shadow:0 0 30px rgba(205,174,255,.35)}
.hero .sub{font-style:italic;font-size:1.5rem;color:var(--text)}
.hero .actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.8rem}
.frame{border:1px solid var(--gold2);padding:.6rem;border-radius:6px;background:var(--bg2);box-shadow:0 0 60px rgba(138,63,224,.35)}
.frame img{width:100%;height:auto;border-radius:2px}

/* sobre */
.about{background:var(--bg2);border-block:1px solid rgba(205,174,255,.2)}
.about .wrap{max-width:46rem;text-align:center}
.about p{font-size:1.3rem}

/* trabalhos */
.services{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem 3rem;max-width:44rem;margin-inline:auto}
.services li{padding:.6rem 0 .6rem 1.8rem;border-bottom:1px solid rgba(205,174,255,.18);position:relative}
.services li::before{content:"✦";position:absolute;left:0;color:var(--rose)}

/* leituras */
.readings{background:var(--bg2)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.card{background:var(--bg);border:1px solid rgba(205,174,255,.3);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}
.card img{width:100%;height:auto;aspect-ratio:2/3;object-fit:cover}
.card .body{padding:1.3rem 1.4rem 1.6rem;display:flex;flex-direction:column;gap:.4rem;flex:1}
.card h3{margin:0}
.card p{color:var(--muted);margin:0}
.price{color:var(--gold);font-size:1.4rem;font-weight:600}
.card .btn{margin-top:auto;justify-content:center;font-size:1rem;padding:.7rem 1rem}
.tiers{list-style:none;margin:.3rem 0 .8rem;padding:0}
.tiers li{display:flex;justify-content:space-between;border-bottom:1px dotted rgba(205,174,255,.3);padding:.2rem 0}
.tiers b{color:var(--gold);font-weight:600}

.extras{list-style:none;margin:0 auto;padding:0;max-width:44rem;display:grid;gap:.8rem}
.extras a{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.3rem;border:1px solid rgba(205,174,255,.3);border-radius:6px;text-decoration:none;background:var(--bg2);font-size:1.25rem;transition:border-color .2s}
.extras a:hover{border-color:var(--gold)}
.extras b{color:var(--gold);font-weight:600;white-space:nowrap}
/* como funciona */
.need{max-width:40rem;margin-inline:auto;display:grid;gap:.8rem;padding:0;list-style:none}
.need li{border-left:2px solid var(--rose);padding-left:1rem}

/* cta */
.cta{text-align:center;background:radial-gradient(ellipse at center,rgba(138,63,224,.3),transparent 70%)}
.cta p{max-width:36rem;margin:0 auto 1.8rem;font-style:italic;font-size:1.4rem}
footer{text-align:center;padding:2rem 1rem 5.5rem;color:var(--muted);font-size:1rem;border-top:1px solid rgba(205,174,255,.2)}
footer a{color:var(--gold)}

/* botão flutuante */
.float{position:fixed;right:1rem;bottom:calc(1rem + env(safe-area-inset-bottom,0px));z-index:10;width:3.6rem;height:3.6rem;border-radius:50%;background:#25d366;display:grid;place-items:center;box-shadow:0 4px 18px rgba(0,0,0,.6)}
.float svg{width:2rem;height:2rem;fill:#fff}

@media (max-width:860px){
  .hero .wrap{grid-template-columns:1fr;gap:2rem;text-align:center}
  .hero .actions{justify-content:center}
  .hero .frame{max-width:420px;margin-inline:auto}
  .cards{grid-template-columns:1fr;max-width:460px;margin-inline:auto}
}
@media (max-width:560px){
  body{font-size:1.1rem}
  section{padding:3rem 0}
  .services{grid-template-columns:1fr}
  .btn{width:100%;justify-content:center}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
